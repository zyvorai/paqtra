# Required
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Server
CILIUM_VISION_HOST=0.0.0.0
CILIUM_VISION_PORT=9191

# Data sources
HUBBLE_ADDRESS=localhost:4245
REDIS_URL=redis://localhost:6379
K8S_CONTEXT=

# Multi-cluster (comma-separated name=host:port)
HUBBLE_ADDRESSES=

# Authentication
AUTH_DISABLED=false

# UI static files
UI_DIST_DIR=

# Prometheus (optional)
PROMETHEUS_URL=

# OpenTelemetry tracing (optional)
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=cilium-vision-api

# TLS (optional — enables HTTPS)
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_PORT=9443

# CORS
ALLOWED_ORIGINS=
