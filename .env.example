# Required
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional auth
ADMIN_USERNAME=admin
# API_KEY=

# Server
PAQTRA_HOST=0.0.0.0
PAQTRA_PORT=9191

# Data sources
HUBBLE_ADDRESS=localhost:4245
# How flows are read: auto (Hubble gRPC API, `hubble` CLI only as fallback), grpc, or cli.
# The gRPC API needs no `hubble` binary.
HUBBLE_MODE=auto
K8S_CONTEXT=

# Multi-cluster (comma-separated name=host:port)
HUBBLE_ADDRESSES=

# Authentication (dev/demo only; requires ENVIRONMENT=development|test)
AUTH_DISABLED=false

# UI static files
UI_DIST_DIR=

# Prometheus (optional)
PROMETHEUS_URL=

# OpenTelemetry tracing (optional)
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=paqtra-api

# TLS (optional — enables HTTPS)
# PAQTRA_DATA_DIR=./data
# Flow history: how long stored flows are kept (1-90 days, default 7) and how
# often Hubble is polled for new ones (seconds, default 30). Each poll keeps the
# most recent 500 flows, so a busy cluster can outrun it; history counts are
# lower bounds.
# PAQTRA_FLOW_RETENTION_DAYS=7
# FLOW_INGEST_INTERVAL_SECS=30
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_PORT=9443

# CORS
ALLOWED_ORIGINS=
