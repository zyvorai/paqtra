# Required
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional auth
ADMIN_USERNAME=admin
# API_KEY=

# Server
PAQTRA_HOST=0.0.0.0
PAQTRA_PORT=9191

# Data sources
HUBBLE_ADDRESS=localhost:4245
K8S_CONTEXT=

# Multi-cluster (comma-separated name=host:port)
HUBBLE_ADDRESSES=

# Authentication (dev/demo only; requires ENVIRONMENT=development|test)
AUTH_DISABLED=false

# UI static files
UI_DIST_DIR=

# Prometheus (optional)
PROMETHEUS_URL=

# OpenTelemetry tracing (optional)
OTEL_EXPORTER_ENDPOINT=
OTEL_SERVICE_NAME=paqtra-api

# TLS (optional — enables HTTPS)
# PAQTRA_DATA_DIR=./data
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_PORT=9443

# CORS
ALLOWED_ORIGINS=
