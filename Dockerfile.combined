# ─────────────────────────────────────────────────────────────
# Cilium Vision — Combined API + UI Image
# Single container with Rust API backend + React UI
# ─────────────────────────────────────────────────────────────

# ── Stage 1: Build UI ────────────────────────────────────────
FROM node:22-alpine AS ui-builder
WORKDIR /ui
COPY web-ui/package*.json ./
RUN npm ci --silent
COPY web-ui/ ./
RUN npm run build

# ── Stage 2: Build API ───────────────────────────────────────
FROM rust:bookworm AS api-builder
WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY web-api/Cargo.toml web-api/Cargo.lock ./
COPY web-api/src ./src
RUN cargo build --release

# ── Stage 3: Runtime ─────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libssl3 wget curl && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -r -u 1000 -m -s /sbin/nologin cilium && \
    mkdir -p /app/ui /etc/cilium-vision

WORKDIR /app

# Copy API binary
COPY --from=api-builder --chown=cilium:cilium /build/target/release/cilium-vision-api ./

# Copy UI static files
COPY --from=ui-builder --chown=cilium:cilium /ui/dist ./ui/

# Default configuration
ENV CILIUM_VISION_HOST=0.0.0.0 \
    CILIUM_VISION_PORT=9191 \
    HUBBLE_ADDRESS=hubble-relay.kube-system.svc.cluster.local:4245 \
    REDIS_URL=redis://localhost:6379 \
    RUST_LOG=info \
    UI_DIST_DIR=/app/ui

USER cilium
EXPOSE 9191

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:9191/health || exit 1

CMD ["./cilium-vision-api"]
