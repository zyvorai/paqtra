# Paqtra - Environment Configuration
# Copy this file to .env and fill in the values before running docker compose.

# REQUIRED: JWT secret for API authentication (minimum 32 characters)
JWT_SECRET=your-secret-key-at-least-32-characters-long

# Optional: Hubble relay address (defaults to localhost:4245)
# HUBBLE_ADDRESS=localhost:4245

# Optional: Allowed CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
